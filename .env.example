APP_NAME=Game Savior
DOMAIN=game.example.com
APP_BASE_URL=http://127.0.0.1:8080
DATABASE_PATH=./data/app.db
ARTIFACT_DIR=./data/artifacts
RETENTION_DAYS=30
TZ=Asia/Shanghai

# 默认直接暴露 8080。HTTPS 部署时改成 127.0.0.1，由 Caddy 代理。
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

SESSION_TTL_HOURS=168
# HTTPS 生产环境建议设为 true；本地通过 http 调试时保持 false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
WORKER_TOKEN=change-worker-token-now

FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 二维码图片消息需要飞书应用凭据和接收目标；Webhook 只用于文本通知
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
# chat_id / open_id / user_id，推荐使用仅自己可见的私聊或群聊 chat_id
FEISHU_RECEIVE_ID_TYPE=chat_id

# 当前阶段只启用崩铁；原神代码保留，但不会创建或领取任务
ENABLE_GENSHIN=false
ENABLE_STARRAIL=true

GENSHIN_WORKDIR=
# BetterGI 尚未启用；获得已验证的运行环境后再填写。
GENSHIN_COMMAND=

# Docker Compose 会覆盖为容器内的 /m7a；下面的值仅用于脱离 Docker 调试 Worker。
STARRAIL_WORKDIR=/m7a
STARRAIL_COMMAND=python main.py main

# March7thAssistant 云星穹铁道模式
MARCH7TH_DOCKER_STARTED=true
MARCH7TH_CLOUD_GAME_ENABLE=true
MARCH7TH_BROWSER_HEADLESS_ENABLE=true
MARCH7TH_AFTER_FINISH=Exit
MARCH7TH_LOG_LEVEL=DEBUG
STARRAIL_CONTROL_DIR=./starrail/control

WORKER_POLL_SECONDS=10

# 可选构建镜像。网络受限时可在 .env 中覆盖为镜像站。
API_IMAGE=python:3.12-slim
MARCH7TH_IMAGE=ghcr.io/moesnow/march7thassistant:latest
PIP_INDEX_URL=https://pypi.org/simple
